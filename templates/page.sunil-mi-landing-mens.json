      "type": "serum-Ingredients",
      "blocks": {
        "serum_rhGnEB": {
          "type": "Serum",
          "settings": {
            "background": "bg-yellow",
            "pd_img": "shopify://shop_images/serhum.png",
            "name": "Rejuvenating Serum",
            "serum_type": "Dark Spots & Uneven Skin Tone",
            "benefit1": "Brightens  discolouration",
            "icon1": "shopify://shop_images/brightens-even-skin-tone_1.png",
            "benefit2": "Fades  dark spots",
            "icon2": "shopify://shop_images/unique_reduce_line.svg",
            "benefit3": "Promotes even  skin tone",
            "icon3": "shopify://shop_images/boosts-hydration-02_1_071958b6-9b9b-428b-bd41-944b7590d5bd.svg",
            "title1": "What can it do for your skin",
            "drop_txt1": "<p>Reveals a <strong>smoother, brighter looking</strong>, and evenly <strong>radiant complexion</strong> to generate a glow effect. Renewal properties to help fade the appearance of dark spots and restore even-looking, smoother-feeling skin.<br/><br/><strong>Skin Concerns:</strong> Designed for skin with discolouration, rough texture, enlarged pores, acne marks and dark spots.</p>",
            "title2": "All Ingredients",
            "drop_txt2": "<p><strong>Epidermal Growth Factor (EGF):</strong><br/>Works at a cellular level to repair and rejuvenate skin. Reduces appearance of wrinkles, improves hydration, and prevents pigmentation.</p><p><strong>Niacinamide:</strong> Superstar ingredient that helps with most skin concerns from soothing to brightening and clarifying, and reducing look of fine lines and wrinkles.</p><p><strong>Tranexamic Acid:</strong> Helps to fade look of dark spots and discolouration. Assists with brightening and evening look of skin tone.</p><p><strong>All ingredients:</strong><br/>Rosa Damascena Flower Water, Propanediol, Glycerin, Tranexamic Acid, Niacinamide, Panthenol, Chrysanthellum Indicum Extract, Ethylhexylglycerin, Tripeptide-1, Xanthan Gum, Allantoin, Sh-Oligopeptide-1.</p><p>Please note that due to innovative updates and changing regulatory guidelines, the ingredient lists provided here may differ slightly from those on our packaging and distributor websites.</p>",
            "title3": "",
            "drop_txt3": "",
            "stars": "shopify://shop_images/results_star-full.svg",
            "review": "“No pain, and no hassle. But what really got me was the results – my skin felt tighter and smoother.”",
            "client": "James T",
            "place": "Miami, USA"
          }
        },
        "or_rCzVfR": {
          "type": "or",
          "settings": {
            "or_txt": "Or"
          }
        },
        "serum_hFbRXg": {
          "type": "Serum",
          "settings": {
            "background": "bg-grey",
            "pd_img": "shopify://shop_images/serum_d1380379-a3b9-410d-b292-baa573e30451.png",
            "name": "Hydra-Soothing Serum",
            "serum_type": "Fine Lines & Wrinkles",
            "benefit1": "Reduces the look of  fine lines & wrinkles",
            "icon1": "shopify://shop_images/unique_plump_fine.svg",
            "benefit2": "Helps soothe  redness",
            "icon2": "shopify://shop_images/unique_soothes_5240f732-2b27-4ebf-ba29-be729b08ac71.svg",
            "benefit3": "Boosts  hydration",
            "icon3": "shopify://shop_images/unique_hydrates_drop_b01213be-21ee-4f0a-a64e-8f4bafa5e86d.svg",
            "title1": "What can it do for your skin",
            "drop_txt1": "<p><strong>Ultra hydration.</strong> Hydrates to help plump skin, reducing the look of fine lines and wrinkles, reduce redness, and supports the skin barrier for firmer-feeling, supple looking skin.<br/><br/><strong>Skin Concerns:</strong> Designed for dull looking skin with wrinkles, fine lines, dehydration, dryness and redness.</p>",
            "title2": "All Ingredients",
            "drop_txt2": "<p><strong>Beta Glucan:</strong> A tall glass of water for your skin. Boosts skin barrier, smooths skin, antioxidant.</p><p><strong>Niacinamide:</strong> Superstar ingredient that helps with most skin concerns from soothing to brightening and clarifying, and reducing fine lines and wrinkles.</p><p><strong>Copper Peptide GHK-Cu</strong>: known for its powerful anti-aging properties. This switch boosts collagen production and skin healing and gives the serum its distinctive blue hue. </p><p><strong>Sodium Hyaluronate: </strong>Hydrating power to lock in moisture more effectively and plump the skin for a firmer, fresher complexion.</p><p><strong>All ingredients:</strong><br/>Rosa Damascena Flower Water, Propanediol, Glycerin, Panthenol, Niacinamide, Myrothamnus Flabellifolia Leaf/Stem Extract, Water, Butylene Glycol, Hydroxyacetophenone, Copper Tripeptide-1, Beta-Glucan, Chrysanthellum Indicum Extract, Ethylhexylglycerin, Sodium Hyaluronate, Allantoin, Xanthan Gum.</p><p>Please note that due to innovative updates and changing regulatory guidelines, the ingredient lists provided here may differ slightly from those on our packaging and distributor websites.</p>",
            "title3": "",
            "drop_txt3": "",
            "stars": "shopify://shop_images/results_star-full.svg",
            "review": "“I have a very dry skin, and finding effective solutions has been a challenge. I hate greasy creams that sit on top of my skin. Micro-Infusion hydrated my skin on a deeper level. Trust me, this stuff is a game-changer!”",
            "client": "James",
            "place": "Dallas, USA"
          }
        }
