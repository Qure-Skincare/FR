        "object_drRUDz": {
          "type": "object",
          "settings": {
            "image": "shopify://shop_images/beauty_micro-men.webp",
            "heading": "Qure Micro-Infusion System",
            "mob_text": "",
            "text": "",
            "price": "",
            "style": "correctCircle",
            "list": "<ul><li>Stamping doesn’t <strong>over-damage</strong> skin</li><li><strong>Little to no downtime</strong> & quick recovery of the skin</li><li>New needle heads provide sharp, straight needles for every treatment - designed for better efficacy</li><li>Disposable heads minimizes risk of infection/ irritation</li><li>Delivers serum directly to skin to help <strong>increase absorption & results</strong></li></ul>"
          }
        },
        "object_THMRbY": {
          "type": "object",
          "settings": {
            "image": "shopify://shop_images/beauty_needle-men.webp",
            "heading": "Other At-Home Needling Devices",
            "mob_text": "",
            "text": "",
            "price": "",
            "style": "incorrectCircle",
            "list": "<ul><li>Rolling can cause <strong>unnecessary damage</strong> of skin</li><li><strong>Slower recovery</strong> & longer healing time</li><li>Needles become blunt after several uses & create unessesary skin trauma which can lessen efficacy</li><li>Infection/ irritation is increased if not disinfected well</li><li><strong>Less effective absorption</strong> of serum as applied topically</li></ul>"
          }
        }
      },
      "block_order": [
        "object_drRUDz",
        "object_THMRbY"
      ],
      "settings": {
        "classname": "beauty_skincare section",
        "sub_head": "",
        "heading": "Typically more effective and safer than other at-home needling devices",
        "heading_reduced": "",
        "text": "<p>Unlike at-home needle roller devices, Micro-infusion requires little to <strong>no downtime,</strong>is <strong>virtually painless, </strong>and minimizes risk of infection and irritation.</p>",
        "text_reduced": "",
