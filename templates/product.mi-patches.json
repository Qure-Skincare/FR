          }
        },
        "tab_pwMUJN": {
          "type": "Tab",
          "settings": {
            "tab_txt": "Traitement",
            "tab_desc": "<p>Appliquez le patch sur une zone souhaitée (rides entre les sourcils, pattes d’oie, sous les yeux ou rides du sourire) avec le côté adhésif vers le bas.</p><p>Appuyez doucement pendant 5 à 10 secondes.</p><p>Utilisez 1 à 2 fois par semaine pendant au moins deux heures.</p><p>Pour de meilleurs résultats, laissez-les toute la nuit !</p>",
