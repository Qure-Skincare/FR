    "pdm_lifestyle_tips_bCbTKb": {
      "type": "pdm_lifestyle-tips",
      "blocks": {
        "tip_WqzmXT": {
          "type": "tip",
          "settings": {
            "title": "Exfoliez 1 à 2 fois par semaine",
            "description": "<p>Avec un peeling à domicile contenant des acides alpha-hydroxylés (AHA) comme les acides glycolique et lactique. Cela aidera à éliminer les peaux mortes incrustées dans les ridules, les rendant moins visibles.</p>",
