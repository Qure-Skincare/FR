n                                                                    <img src=\"{{ '10_mins.png' | asset_url }}\" alt=\"\">\n                                                                    <p>Traitement quotidien<br> rapide<\/p>\n                                                                <\/li>\n                                                            <\/ul>\n                                                        <\/div>\n                                                    <\/div>\n                                                <\/div>\n                                            <\/div>\n                                        <\/div>\n                                    <\/div>"
          }
