    "pdm_dual_section_text_image_aTMNRM": {
      "type": "pdm_dual-section-text-image",
      "settings": {
        "section_title": "Feeling you look younger and having positive aging experiences are linked,",
        "section_subtitle": "say 59% of participants in a study by the University of Oklahoma",
        "paragraph": "<p><strong>A </strong><a href=\"https://www.ou.edu/news/articles/2024/february/from-wrinkles-to-wisdom-new-research-explores-the-complex-relationship-between-age-appearance-and-health\" target=\"_blank\" title=\"https://www.ou.edu/news/articles/2024/february/from-wrinkles-to-wisdom-new-research-explores-the-complex-relationship-between-age-appearance-and-health\"><strong>recent</strong></a><strong> study by the University of Oklahoma </strong>found t that those who felt they looked younger than they were also reported having more positive experiences related to aging, such as being asked for advice and wisdom and having a strong sense of purpose. Conversely, those who felt older had more negative experiences related to ageism, which can cause chronic stress and even be harmful to health. <br/>While several factors beyond dermatological care impact self-esteem, taking care of ourselves, protecting, nurturing, and rejuvenating our skin can greatly impact how we present ourselves to the world and, in turn, our experiences.<br/>In this personalized skincare plan, you will find a step-by-step guide and all the necessary products to reduce fine lines and wrinkles in your skin so that you can feel comfortable and joyful going out into the world.<br/><br/></p>",
        "button_text": "Read More",
        "dual_img": "shopify://shop_images/image_2_20e2716f-1990-40f6-b709-090f1113a0ab.jpg"
      }
    },
