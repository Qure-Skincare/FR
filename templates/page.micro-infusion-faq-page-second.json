        "steps_BeYexK": {
          "type": "steps",
          "settings": {
            "step_image": "shopify://shop_images/imfage.png",
            "text_content": "<p><strong>Préparez votre peau : </strong>Nettoyez votre visage en profondeur pour éliminer maquillage ou impuretés. Séchez avec une serviette propre.</p>"
          }
        },
        "steps_fiFE9T": {
          "type": "steps",
          "settings": {
            "step_image": "shopify://shop_images/1a_1_d45eada7-9740-4342-a28f-e6b610559b0c.png",
            "text_content": "<p><strong>Préparez l’appareil : </strong>Dévissez la chambre et remplissez-la avec une ampoule du sérum choisi. Fixez la tête de micro-aiguilles en la vissant fermement.</p>"
          }
        },
        "steps_PC4eAT": {
          "type": "steps",
          "settings": {
            "step_image": "shopify://shop_images/imhhage.png",
            "text_content": "<p><strong>Activez l’appareil : </strong>Laissez l’appareil à l’envers pendant 1 à 2 minutes pour permettre au sérum de s’écouler dans les micro-aiguilles.</p>"
          }
        },
        "steps_j3JHym": {
          "type": "steps",
          "settings": {
            "step_image": "shopify://shop_images/fe.png",
            "text_content": "<p><strong>Infusez : </strong>Retirez le couvercle et pressez doucement l’appareil sur votre peau, en commençant par le centre du visage et en allant vers l’extérieur. Utilisez un mouvement de tamponnage pour une couverture uniforme.</p>"
          }
        },
        "steps_6fwQwn": {
          "type": "steps",
          "settings": {
            "step_image": "shopify://shop_images/imaege.png",
            "text_content": "<p><strong>Après-soin : </strong>Tapotez le sérum restant sur votre visage et votre cou. Une fois terminé, remettez le couvercle sur la tête d’aiguilles, dévissez-la et jetez-la en toute sécurité.</p>"
          }
        }
      },
