        "collapsed_RPxPyF": {
          "type": "collapsed",
          "settings": {
            "show": false,
            "style": "grey",
            "heading": "Détails du traitement",
            "content": "<ul><li><strong>UTILISATION :</strong> Utilisation quotidienne après le nettoyage, avant les soins topiques</li><li><strong>TRAITEMENT ANTI-ÂGE :</strong> 415 nm (Bleu), 605 nm (Ambre), 630 nm (Rouge), 660 nm (Rouge profond), 880 nm (Infrarouge)</li><li><strong>TRAITEMENT ANTI-IMPERFECTIONS :</strong> 415 nm (Bleu), 630 nm (Rouge)</li><li><strong>TRAITEMENT PERSONNALISÉ :</strong> Choisissez les modes de traitement pour chaque zone du visage</li><li><strong>TYPE DE PEAU :</strong> Plus adapté aux types de peau Fitzpatrick I-IV</li></ul>",
