        "serum_RgixpW": {
          "type": "Serum",
          "settings": {
            "background": "bg-grey",
            "pd_img": "shopify://shop_images/serum_d1380379-a3b9-410d-b292-baa573e30451.png",
            "name": "Sérum hydra-apaisant",
            "serum_type": "Ridules et rides",
            "benefit1": "Réduit l’apparence des ridules et rides",
            "icon1": "shopify://shop_images/unique_plump_fine.svg",
            "benefit2": "Aide à apaiser les rougeurs",
            "icon2": "shopify://shop_images/unique_soothes.svg",
            "benefit3": "Stimule l’hydratation",
            "icon3": "shopify://shop_images/unique_hydrates_drop.svg",
            "title1": "Que peut-il faire pour votre peau",
            "drop_txt1": "<p><strong>Ultra-hydratation.</strong> Hydrate pour aider à repulper la peau, réduisant l’apparence des ridules et des rides, diminuant les rougeurs et renforçant la barrière cutanée pour une peau d’apparence plus ferme et souple.</p><p><strong>Problèmes de peau :</strong> Conçu pour les peaux ternes avec rides, ridules, déshydratation, sécheresse et rougeurs.</p>",
            "title2": "Tous les ingrédients",
            "drop_txt2": "<p><strong>Bêta-glucane :</strong> Un grand verre d’eau pour votre peau. Renforce la barrière cutanée, lisse la peau, antioxydant.</p><p><strong>Niacinamide :</strong> Ingrédient superstar qui aide à résoudre la plupart des problèmes de peau, de l’apaisement à l’éclaircissement et à la clarification, en réduisant les ridules et les rides.</p><p><strong>Peptide de cuivre GHK-Cu :</strong> Reconnu pour ses puissantes propriétés anti-âge. Cet élément stimule la production de collagène et la guérison de la peau, et donne au sérum sa teinte bleue distinctive.</p><p><strong>Hyaluronate de sodium :</strong> Pouvoir hydratant pour retenir l’humidité plus efficacement et repulper la peau pour un teint plus ferme et frais.</p><p><strong>Tous les ingrédients :</strong><br/>Eau de fleur de Rosa Damascena, Propanediol, Glycérine, Panthénol, Niacinamide, Extrait de feuille/tige de Myrothamnus Flabellifolia, Eau, Butylène glycol, Hydroxyacétophénone, Tripeptide-1 de cuivre, Bêta-glucane, Extrait de Chrysanthellum Indicum, Ethylhexylglycérine, Hyaluronate de sodium, Allantoïne, Gomme de xanthane.</p><p>Veuillez noter que, en raison d’innovations et de modifications des réglementations, les listes d’ingrédients fournies ici peuvent légèrement différer de celles sur nos emballages et sites de distributeurs.</p>",
            "title3": "",
            "drop_txt3": "",
            "stars": "shopify://shop_images/results_star-full.svg",
            "review": "« Ma peau manquait toujours d’hydratation, ça a revitalisé ma peau et maintenant elle rayonne !! »",
            "client": "Monika Smith",
            "place": "Miami, États-Unis"
          }
        }
