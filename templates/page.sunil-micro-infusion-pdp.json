      "blocks": {
        "tab_8DYLCh": {
          "type": "Tab",
          "settings": {
            "tab_txt": "Préparer",
            "tab_desc": "<p>Dévisser la chambre de l’appareil et remplir avec une ampoule de sérum. Visser la tête d’aiguille avec le couvercle pour bien fermer.<br/>Laisser l’appareil à l’envers pendant 1 à 2 minutes. Pendant ce temps, lavez votre visage et assurez-vous que vos mains sont propres.</p>",
            "image": "shopify://shop_images/6_ea9ed242-a7b5-4cdc-941b-ad54c7da2260.png"
          }
        },
        "tab_UzUCKk": {
          "type": "Tab",
          "settings": {
            "tab_txt": "Traitement",
            "tab_desc": "<p>Une fois que le sérum a eu assez de temps pour atteindre les aiguilles, vous pouvez retirer le couvercle et commencer la micro-infusion !<br/>Commencez au centre du visage et progressez vers l’extérieur pour couvrir tout le visage. Faites 2/3 passages. Prenez le sérum restant dans l’appareil et tapotez-le sur votre visage et votre cou pour le laisser agir toute la nuit.</p>",
            "image": "shopify://shop_images/1a_3.png"
          }
        },
        "tab_kkmNwF": {
          "type": "Tab",
          "settings": {
            "tab_txt": "Après-soin",
            "tab_desc": "<p>Une fois le traitement terminé, remettez le couvercle sur la tête d’aiguille. Dévissez le couvercle et jetez-le en toute sécurité.<br/>Ouvrez une nouvelle tête d’aiguille stérile et placez-la sur l’appareil pour votre prochain traitement.</p>",
            "image": "shopify://shop_images/1a_4tt.png"
          }
        },
