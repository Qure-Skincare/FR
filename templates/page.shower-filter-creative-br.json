        "collapsed_EYEMK6": {
          "type": "collapsed",
          "settings": {
            "show": false,
            "style": "default",
            "heading": "Installation steps",
            "content": "<ul><li>Remove the Old Shower Head - Use the provided wrench or your hands to unscrew the old shower head by turning it counterclockwise. Discard the old head or keep it for future use.</li><li>Check the Qure Shower Filter - Inspect the neck of the Qure Shower Filter to ensure the filter is properly installed. The filter is already placed inside for convenience, but double-checking will help prevent issues.</li><li>Wrap the Pipe Threads - Use the plumber tape provided in the Qure Shower Filter kit. Wrap it around the pipe threads where the new shower head will attach. Wrap it twice to ensure a watertight seal, then tear the tape.</li><li>Install the Qure Shower Filter - Twist the Qure Shower Filter onto the prepared pipe until it’s securely fastened. Use the wrench to ensure it is tightly secured, but avoid over-tightening.</li><li>Test the Water Flow - Turn on the water and check for any leaks. If no leaks are present, you’re ready to enjoy your new, purified shower experience.</li></ul>",
            "code": ""
          }
