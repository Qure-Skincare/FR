                    >
                      <div class="pdm_plan-choosen">
                        <p>
                          Meilleure offre
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="10"
                            height="10"
                            viewBox="0 0 10 10"
                            fill="none"
                          >
                            <path d="M5 0.5L6.22371 3.70411L9.5 3.93769L6.98 6.15153L7.78115 9.5L5 7.66411L2.21885 9.5L3.02 6.15153L0.5 3.93769L3.77629 3.70411L5 0.5Z" fill="#FFFAF0"/>
                          </svg>
                        </p>
                      </div>

                      {% assign price_first_element = product.price %}
                      <input
                        type="radio"
                        name="monthlyPlan"
                        id="3_month"
                        checked
