    <script src="{{ '__app_serums-months-form-v2.js' | asset_url }}"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            v2__selectProduct('{{ section_id }}_');

            
            const v2__parent = '.form-{{ section_id }}';
            const v2__buyButton = document.querySelector(v2__parent + ' .buy_btn');
            const v2__buyButtonSoldOut = document.querySelector(v2__parent + ' .buy_btn_soldout');
            const v2__savedAmount = document.querySelector(v2__parent + ' .savedAmount');

            const v2__stoggleSoldOutButton = () => {    
                if (v2__savedAmount && v2__buyButton && v2__buyButtonSoldOut) {
                    if (v2__savedAmount.textContent.trim() === "& SAVE {{ soldout_percentage }}%") {
                        v2__buyButton.style.display = "none";
                        v2__buyButtonSoldOut.style.display = "block";
                    } else {
                        v2__buyButton.style.display = "block";
                        v2__buyButtonSoldOut.style.display = "none";
                    }
                }
            }

            const v2__observer = new MutationObserver(v2__stoggleSoldOutButton);
            if (v2__savedAmount) {
                v2__observer.observe(v2__savedAmount, { childList: true, subtree: true });
            }
            
        });
    </script>

