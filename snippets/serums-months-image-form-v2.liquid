{% liquid
  assign price_first_element = ''
  assign price_second_element = ''
  assign price_third_element = ''
%}

{% if section_id == blank %}
  <p>Veuillez fournir la propriété section_id pour utiliser cet extrait</p>
{% else %}
  <style>
    .offer_active
      .supply_steps
      .step_block
      .step_content
      .serumBlock
      input.active
      + .serum_prd:after {
      display: none !important;
    }

    .planBlock .plan_choosed span {
      background: #000 !important;
    }

    .planBlock .plan_choosed {
      text-align: left !important;
      position: relative !important;
      left: 30px !important;
      max-width: 100% !important;
    }
    .step_counter_before:before {
      display: none !important;
    }
  </style>

  <!-- treatment section start -->
  <div class="available_bar">
    <p>DISPONIBLE JUSQU'À ÉPUISEMENT DES STOCKS</p>
  </div>
  <div
    class="section productSubscription choose_serum form-{{ section_id }}"
    id="productSubscription"
  >
    <div class="container">
      <div class="row">
        <div class="col-md-6">
          <div class="qure__treatments">
            <div class="text-start order-2 order-md-1">
              <div class="section__header d-none d-md-block">
                <h2 class="title-lg">Choisissez vos options de traitement</h2>
                <div class="des">
                  <p>
                    <strong
                      >Soyez rassuré, tous les achats sont uniques.</strong
                    >
                  </p>
                  <p>
                    Vous ne serez pas facturé à nouveau les mois suivants, et il
                    n'y a aucun frais caché. Lorsque vous serez prêt à
                    recommander votre traitement, vous pourrez acheter des têtes
                    d'aiguilles et le sérum de votre choix.
                  </p>
                </div>
              </div>
            </div>
            <div class="tmtFtrs_image order-1 order-md-2">
              <div class="section__header d-block d-md-none">
