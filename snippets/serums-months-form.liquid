        >Acheter maintenant
        <span
          class="savedAmount"
          >& ÉCONOMISEZ {{ discount_percentage }}%</span
        ><img src="{{ 'arrow_right.svg' | asset_url }}" alt="">
      </a>

      <a
        class="btn btn-lg btn-lg-small-text btn-primary buy_btn_soldout mt-3 {{ section_id }}_productButtonSoldOutObject"
        style="display: none;"
        >Sold Out</a
      >
    </div>

