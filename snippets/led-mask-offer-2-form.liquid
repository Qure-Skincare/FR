                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="bundle_select-main include ps-md-3">
                                <div class="product_details">
                                    <!--
                                    <div class="holiday_spcl mb-md-2 mb-3 justify-content-start">
                                        <p class="save_txt">HOLIDAY SPECIAL <span>| Available Until February 28th</span></p>
                                    </div>
                                    -->
                                    <h2 class="title-lg">Q-Rejuvalight Pro LED Mask<br>
