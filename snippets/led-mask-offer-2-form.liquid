                                            </div>
                                        </div>
                                    </div>
                                    <div class="include_checkout">
                                        <div class="row justify-content-between">
                                            <div class="col-auto">
                                                <p class="green_txt">INSTANT SAVINGS: {{ 299 | times: 100 | money_without_trailing_zeros }}</p>
                                            </div>
                                            <div class="col-auto">
                                                <h6><del class="text-grey">{{ 698 | times: 100 | money_without_trailing_zeros }}</del> <span>{{ 399 | times: 100 | money_without_trailing_zeros }}</span></h6>
