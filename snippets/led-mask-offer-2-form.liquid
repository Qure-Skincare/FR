                                                </div>
                                                <div class="col-sm-2 col-3">
                                                    <h6>83% SOLD</h6>
                                                </div>
                                            </div>
                                        </div>

                                        {% comment %} <div class="next_batch_bl next_batch_highlight">
                                            <h5 class="d-block d-md-block">Next batch ships January 31st:</h5>
                                            <p>Due to high demand, this offer has limited availability.</p>
                                            <div class="batch_h batch_h_fade mt-3 mt-md-4">
                                                <div class="batch_h_month">December 2nd</div>
                                                <div class="batch_h_info sold_out_h" style="--bgPercent:100%;"><span>SOLD
                                                        OUT</span></div>
                                            </div>
                                            <div class="batch_h my-2">
                                                <div class="batch_h_month fw-bold">January 31st</div>
                                                <div class="batch_h_info" style="--bgPercent:81%;">78% Reserved</div>
                                            </div>
                                        </div> {% endcomment %}
                                        <div class="order_today">
                                            <p>Order today to lock in your deal and get <strong
                                                    class="d-block d-md-inline-block">FREE Shipping</strong></p>
                                        </div>
                                    </div>
                                    <!-- Buy Now Button -->
                                    <button class="buy-now" id="buy-now-button">Buy Now & Save {{ 299 | times: 100 | money_without_trailing_zeros }}</button>

                                    <!-- Payment Methods -->
                                    <div class="payment_method">
                                        <p>or pay 4 monthly payments of {{ 99.75 | times: 100 | money_without_trailing_zeros }} with</p>
                                        <div class="pmt_img ps-2">
                                            <img src="https://qureskincaredns.com/new/assets/klarna.svg" alt="Klarna">
                                            <img src="https://qureskincaredns.com/new/assets/sezzle.svg" alt="Sezzle">
                                            <img src="https://qureskincaredns.com/new/assets/afterpay.svg" alt="Afterpay">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- product bundle end -->

{% assign amount = 299 | times: 100 | money_without_trailing_zeros %}

<script>
    document.getElementById('buy-now-button').addEventListener('click', function() {
        
        let __discount = '';
        let __items = [];

        __items.push({
            id: 46181053858031,
            quantity: 1
        });

        __items.push({
            id: 44062187913455,
            quantity: 1
        });

        __discount = 'FREEN&DOFFER';

        if(__discount)
        {
            fetch('/discount/' + __discount).then(async () => {
                cartRequestAdd({ 
                    items:  __items
                }, {} )
            });
        }
        else
        {
            cartRequestAdd({ 
                items:  __items
            }, {} )
        }
    });

    document.addEventListener("DOMContentLoaded", function() {
        var swiper = new Swiper(".bfs_mb_sl", {
            spaceBetween: 0,
            slidesPerView: 4,
            watchSlidesProgress: true,
            breakpoints: {
                768: {
                    spaceBetween: 0,
                    slidesPerView: 4,
                },

            },
        });

        var swiper2 = new Swiper(".bfs_mb_sl2", {
            spaceBetween: 10,
            navigation: {
                nextEl: ".thumb-next",
                prevEl: ".thumb-prev",
            },
            thumbs: {
                swiper: swiper,
            },
        });
    });

    document.addEventListener("DOMContentLoaded", function() {
        let find = '$299';
        let replace = '{{ amount }}';
        const spanEl = document.querySelector('.header_btn span');
        
        if (spanEl && spanEl.textContent.includes(find)) {
            spanEl.textContent = spanEl.textContent.replace(find, replace);
        }

        document.querySelectorAll('a.btn-primary').forEach(aEl => {
            if (aEl.textContent.includes(find)) {
                aEl.textContent = aEl.textContent.replace(find, replace);
            }
        });
    });
</script>