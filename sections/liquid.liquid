{{ section.settings.code }}

{% schema %}
    {
        "name": "t:sections.liquid.name",
        "class": "section-liquid",
        "settings": [
            {
                "type": "liquid",
                "id": "code",
                "label": "t:common.code.label"
            },
            {
                "type": "checkbox",
                "id": "popup_micro_infusion_enabled",
                "label": "Popup Micro Infusion Enabled",
                "default": true,
                "info": "this will enable the popup micro infusion only for: qure-microinfusion-offer and qure-micro-infusion-landing-page-affiliate, and serum form on pdp \n\n files: snippets/serums-months-image-form.liquid, snippets/serums-months-image-form-v2.liquid"
            },
            {
                "type": "header",
                "content": "Payment Icons",
                "info": "Icons for: snippets/serums-months-image-form-v2.liquid"
            },
            {
                "type": "image_picker",
                "id": "payment_icons",
                "label": "Payment Icons full"
            },
            {
                "type": "image_picker",
                "id": "payment_icons_today_only",
                "label": "Payment Icons today only"
            }
        ],
        "presets": [
			{
				"name": "t:sections.liquid.name"
			}
        ]
    }
{% endschema %}