{%- assign product_count = 0 -%}

{%- for block in section.blocks -%}
	{%- case block.type -%}
        {%- when 'link' -%}
            {% assign location_href = block.settings.link_url %}
        {%- when 'product' -%}
            {%- assign product_count = product_count | plus: 1 -%}
    {%- endcase -%}
{%- endfor -%}

<link rel="stylesheet" href="{{ 'homepage_promo_second.css' | asset_url }}">

{% capture content %}
<!-- -- main banner start -- -->
<div class="bf_sale-banners">
    <!-- hero valentine banner  -->
    <div class="hero_valentine_banner position-relative main_banner womens_day_banner_outer">
        <div class="container-fluid px-0">
            {% if section.settings.image != blank %}
                <div class="d-none d-md-block">
                    <img src="{{ section.settings.image | img_url: 'master' }}" alt="" class="img-fluid w-100">
                </div>
            {% endif %}
            {% if section.settings.image_mobile %}
                <div class="d-md-none">
                    <img src="{{ section.settings.image_mobile | img_url: '900x' }}" alt="" class="img-fluid w-100">
                </div>
            {% endif %}
            <div class="collection_grid main_b_wrapper py-3 womens_day_banner_ctm">
                <div class="banner_text w-100 womens_day_offer justify-content-md-start">
                    <div class="womens_day_banner">
                        {% if section.settings.heading != blank %}
                            <p>{{ section.settings.heading }}</p>
                        {% endif %}
                        {% if section.settings.subheading != blank %}
                            <h3>{{ section.settings.subheading | replace: '<p>', '' |  replace: '</p>', ''  }}</h3> 
                        {% endif %}   
                        
                        {%- for block in section.blocks -%}
                            {% if block.type == 'link' %}
                                <a href="{{ block.settings.link_url }}" class="btn_black btn mb-0 mt-2 mt-md-4" aria-label="{{ block.settings.link_label | escape }}">{{ block.settings.link_label }}</a>
                            {% endif %}
                        {%- endfor -%}
                    </div>

                </div>
                <div class="holiday_banner womens_day_holiday d-none d-md-block">
                    <div class="bundle_slider-main">
                        <div class="bf_sale-slider pt-md-0">
                            <div class="swiper holiday_bundle dot_pagination">
                                <div class="swiper-wrapper">
                                    <div class="swiper-slide">
                                        <div class="new-slide_ctm">
                                            <div class="new_img">
                                                <img src="https://qureskincaredns.com/new/assets/womens_day_bundle.webp" alt="" class="img-fluid">
                                            </div>
                                            <div class="new_img">
                                                <img src="https://qureskincaredns.com/new/assets/plus.webp" alt="" class="img-fluid">
                                            </div>
                                            <div class="position-relative">
                                                <div class="new_img">
                                                    <img src="https://qureskincaredns.com/new/assets/mi_bundle_women_day.webp" alt="" class="img-fluid">
                                                </div>
                                                <div class="mi_bndl_women">
                                                    <p class="free_text"><span class="discount_badge">FREE</span></p>
                                                    <div class="mi_bndl_dv mt-1">
                                                        <h4 class="mi_bndl_text">Micro-Infusion Bundle</h4>
                                                        <p class="valued_at">VALUED AT <strong>$357</strong></p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div
                                class="holiday_bundle-swiper-prev swiper-button-prev swiper-button d-md-flex d-none">
                            </div>
                            <div
                                class="holiday_bundle-swiper-next  swiper-button-next swiper-button d-md-flex d-none">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="holiday_banner womens_day_holiday_mob d-md-none bg-white py-3 py-md-0">
            <div class="bundle_slider-main mx-auto">
                <div class="bf_sale-slider p-0">
                    <div class="swiper holiday_bundle dot_pagination">
                        <div class="swiper-wrapper">
                            <div class="swiper-slide">
                                <div class="new-slide_ctm">
                                    <div class="new_img">
                                        <img src="https://qureskincaredns.com/new/assets/womens_day_bundle.webp" alt="" class="img-fluid">
                                    </div>
                                    <div class="new_img">
                                        <img src="https://qureskincaredns.com/new/assets/plus.webp" alt="" class="img-fluid">
                                    </div>
                                    <div class="position-relative"> 
                                        <div class="new_img">
                                            <img src="https://qureskincaredns.com/new/assets/mi_bundle_women_day.webp" alt="" class="img-fluid">
                                        </div>
                                        <div class="mi_bndl_women">
                                            <p class="free_text"><span class="discount_badge">FREE</span></p>
                                            <div class="mi_bndl_dv">
                                                <h4 class="mi_bndl_text">Micro-Infusion Bundle</h4>
                                                <p class="valued_at">VALUED AT <strong>{{ 357 | times: 100 | money_without_trailing_zeros }}</strong></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div
                        class="holiday_bundle-swiper-prev swiper-button-prev swiper-button d-md-flex d-none">
                    </div>
                    <div
                        class="holiday_bundle-swiper-next  swiper-button-next swiper-button d-md-flex d-none">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- hero valentine banner end  -->

    <!-- Sub banner  -->
    {%- for block in section.blocks -%}
        {% if block.type == 'banner' %}
            <!-- Sub banner  -->
            <div class="sub_banner main_banner position-relative">
                {% if block.settings.image != blank %}
                    <picture>
                        <source media="(min-width:1100px)" srcset="{{ block.settings.image | img_url: 'master' }}">
                        {% if block.settings.image_mobile %}
                            <source media="(min-width:720px)" srcset="{{ block.settings.image_mobile | img_url: '720x' }}">
                            <source media="(min-width:540px)" srcset="{{ block.settings.image_mobile | img_url: '540x' }}">
                        {% endif %}
                        {% if block.settings.image_mobile %}
                            <img class="img-fluid" src="{{ block.settings.image_mobile | img_url: '540x' }}" alt="{{ block.settings.image_mobile.alt | escape }}" width="125" height="186">
                        {% else %}
                            <img class="img-fluid" src="{{ block.settings.image | img_url: '540x' }}" alt="{{ block.settings.image.alt | escape }}" width="225" height="281" alt="">
                        {% endif %}
                    </picture>
                {% endif %}
                <div class="main_b_wrapper">
                    <div class="container">
                        <div class="sub_banner-content">
                            {% if block.settings.heading != blank %}
                                <h2 class="mb-0">
                                    {{ block.settings.heading }}
                                </h2>
                            {% endif %}
                            {% if block.settings.link_label != blank %}
                                <a href="{{ block.settings.link_url }}" class="btn_black mb-0">{{ block.settings.link_label }}</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            <!-- Sub banner end -->
        {% endif %}
    {%- endfor -%}
    <!-- Sub banner end -->
</div>
<!-- -- main banner start -- -->
{% endcapture %}

{% assign amount = 357 | times: 100 | money_without_trailing_zeros %}

{{ content | replace: '$357', amount }}


