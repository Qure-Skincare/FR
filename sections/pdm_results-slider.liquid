<!-- -- result section start -- -->
<div class="result_pwd mi_landing_result pwd-results-slider" id="result_section">
    <div class="pwd-container">
        <div class="section_header text-lg-center text-start mb-3 mw-100">
            {% if section.settings.heading != blank %}
            <h2 class="title-lg">
                {{ section.settings.heading }}
            </h2>
            {% endif %}
            {% if section.settings.stars != blank %}
            <div class="refill_review justify-content-center">
                <div class="star_gp">
                    <img src="{{ section.settings.stars | img_url: '130px' }}" alt="">
                </div>
                <p>{{ section.settings.rating_text }}</p>
            </div>
            {% endif %}
        </div>
        <div class="result_s_wrapper">
            <div class="swiper dot_pagination pwd-result_slider">
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                    <div class="swiper-slide">
                        <div class="pwd-result_item">
                            <div class="result_img_m">
                                {% if block.settings.image != blank %}
                                <div class="results">
                                  <div class="before">
                                    <p class="ref">{{ block.settings.after }}</p>
                                    <p class="visible">{{ block.settings.before }}</p>
                                  </div>
                                  <div class="after">
                                    <p class="visible">{{ block.settings.after }}</p>
                                    <p class="ref">{{ block.settings.before }}</p>
                                  </div>
                                </div>
                                <img src="{{ block.settings.image | image_url: width: 422, height: 268 }}" alt="">
                                {% endif %}
                            </div>
                            <div class="cont_info">
                            <div class="result_item_info">
                                {% if block.settings.heading != blank %}
                                <div class="card-title">
                                    <p>{{ block.settings.heading }}</p>
                                </div>
                               {% endif %}
                              {% if block.settings.text != blank %}
                                <div class="result_content">
                                    {{ block.settings.text }}
                                </div>
                              {% endif %}
                              <div class="cont-flag">
                                <div class="r_flag">
                                            {% if block.settings.image_country != blank %}
                                            <div class="flag_img">
                                                <img src="{{ block.settings.image_country | img_url: '25x' }}" alt="">
                                            </div>
                                            {% endif %}
                                            {% if block.settings.client != blank %}
                                            <p class="r_c_name pe-2">{{ block.settings.client }}</p>
                                            {% endif %}
                                        </div>
                                        {% if block.settings.verified != blank %}
                                        <div class="verified_img">
                                            <img src="{{ 'verified.svg' | asset_url }}" alt="Verified icon">
                                            <p>Verified customer</p>
                                        </div>
                                        {% endif %}
                              </div>
                            </div>
                            {% if block.settings.product != blank %}
                              {% assign cta_link = block.settings.product.url %}
                              {% assign enable_go_to_product =  block.settings.cta_go_to_product %}
                              {% assign cta_url = block.settings.cta_url %}

                                {% if enable_go_to_product == false and cta_url != blank %}
                                  {% assign cta_link = cta_url %}
                                {% endif %}

                              <a href="{{ cta_link }}">
                                <div class="product">
                                  {% assign image_product = block.settings.product.featured_image %} 
                                  {% assign name_product = block.settings.product.title %} 
                                  {% assign show_product_name = block.settings.show_product_name %}
                                  {% assign cta_text = block.settings.cta_text %}

                                  {% if show_product_name == false and cta_text != blank %}
                                    {% assign name_product = cta_text %}
                                  {% endif %}

                                  <img src="{{ image_product | img_url: 'small' }}" alt="{{ name_product }}">
                                  <p class="producto-name">{{ name_product }}</p>
                                </div>
                              </a>
                            {% endif %}
                                    
                            </div>
                            
                        </div>
                    </div>
                    {% endfor %}
                </div>
                <div class="pagination_navigation">
                    <div class="swiper-pagination"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- -- result section end -- -->

{% schema %}
{
  "name": "Pwd Results Slider (PDM)",
  "tag": "section",
  "class": "section-slider-pwd-results-slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading.label",
      "default": "No promises, just proof"
    },

  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:common.heading.label",
          "default": "Wish I had this technology years ago!"
        },
        {
          "type": "text",
          "id": "before",
          "label": "Before text",
          "default": "BEFORE"
        },
        {
          "type": "text",
          "id": "after",
          "label": "After text",
          "default": "AFTER"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:common.image.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>After two weeks I began to see results and after six weeks the changes in my skin were dramatic. I have now been using Qure six months and loving the compliments! I bought masks for my daughters for Christmas so they could start at a younger age.... I wish this technology had been available when I was younger. I am 76 years old!</p>",
          "label": "t:common.text.label"
        },
        {
          "type": "image_picker",
          "id": "image_country",
          "label": "t:common.client.country.label"
        },
        {
          "type": "text",
          "id": "client",
          "label": "t:common.client.label"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "t:common.checkbox.verified",
          "default": true
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:common.product.label"
        },
        {
          "type": "checkbox",
          "id": "cta_go_to_product",
          "label": "CTA go to product",
          "default": true
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "CTA URL"
        },
        {
          "type": "checkbox",
          "id": "show_product_name",
          "label": "Show product name",
          "default": true
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Product CTA text",
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pwd Results Slider (PDM)",
      "blocks":[
        {
          "type":"slide"
        }
      ]
    }
  ]
}
{% endschema %}
