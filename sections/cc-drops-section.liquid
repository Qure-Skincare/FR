      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 5px;
  }

  .productBlockGrid .collection-form .button_primary {
      /* width: 130px; */
      background-color: #000;
      border-radius: 100px;
      font-weight: 500;
      font-size: 18px;
      line-height: 27px;
      text-align: center;
      letter-spacing: .2px;
      color: #fff;
      height: 38px;
      padding: 5px 20px;
      text-transform: capitalize;
