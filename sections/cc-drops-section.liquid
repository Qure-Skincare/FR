{%- style -%}
  .collectio-banner {
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
  }

  .collectio-banner h1 {
      position: absolute;
      font-family: Poppins;
      font-style: normal;
      font-weight: 400;
      font-size: 34px;
      line-height: 48px;
      text-align: center;
      letter-spacing: .3px;
      color: rgb(0 0 0 / 80%);
  }

  .collectio-banner img {
      max-width: 100%;
  }
  .fullImage img{
      width: 100%;
      object-fit: cover;
  }
  @media(max-width:767px) {
      .collectio-banner h1 {
          font-size: 18px;
          line-height: 24px;
          width: 176px;
      }
  }

  .collection.collection-container.container {
      padding-top: 25px;
      padding-bottom: 50px;
  }

  .product-grid-container {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
  }

  .productBlockGrid {
      border-radius: 8px;
      border: 1px solid rgba(0, 0, 0, 0.08);
      position: relative;
      overflow: hidden;
    min-height:600px;
  }

  .fixed_height_btn {
      position: relative;
      padding-bottom: var(--collectionBtnHeight);
  }

  .pdt_cln_bottom {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
  }

  .productBlockGrid .product-grid__image img {
      max-width: 100%;
  }

  .productBlockGrid .cus-tag {
      position: absolute;
      right: 13px;
      top: 13px;
      padding: 1.1px 1.5px .5px;
      border-radius: 5px;
      z-index: 1;
      display: flex;
      align-items: center;
  }

  .productBlockGrid .cus-tag .cus-save,
  .cus-tag .cus-seller {
      font-size: 11px;
      line-height: 14px;
      letter-spacing: .3px;
      text-transform: uppercase;
      padding: 0 7px;
      font-weight: 600;
      text-align: center;
      color: #000;
  }

  .productBlockGrid .cus-tag .cus-save {
      border-radius: 4px 0 0 4px;
      background: #c7e7dc;
      border: 1px solid #c7e7dc;
  }

  .productBlockGrid .cus-tag .cus-seller {
      border: 1px solid #c7e7dc;
      border-radius: 0 4px 4px 0;
      background-color: #fff;
  }

  .productBlockGrid .collection-review {
      margin-top: 13px;
      text-align: left;
      display: flex;
      align-items: center;
  }

  .productBlockGrid .collection-review .prdStar svg {
      width: 85px;
      height: 22px;
  }

  .productBlockGrid .collection-review span {
      font-family: Poppins;
      font-style: normal;
      font-weight: 400;
      font-size: 12px;
      line-height: 20px;
      color: #000;
      text-decoration: none;
      margin-left: 9px;
  }

  .col-product .product-grid__title {
      font-weight: 500;
      line-height: 26px;
      letter-spacing: .3px;
      color: #000;
      text-align: left;
      text-transform: capitalize;
      margin-top: 7px;
      max-height: 104px;
      font-size: 13px;
      margin-bottom: 10px;
  }

  .productBlockGrid .collection-description {
      font-family: Poppins;
      font-style: normal;
      font-weight: 300;
      font-size: 11px;
      line-height: 18px;
      letter-spacing: .3px;
      color: #000;
      text-align: left;
      margin-bottom: 10px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
  }

  .productBlockGrid .product-grid__price.abtest {
      font-size: 18px;
      text-align: left;
      line-height: 100%;
      display: flex;
      align-items: center;
      width: 100%;
      font-weight: 600;
  }

  .productBlockGrid .product-grid__price.abtest .product-grid__sale-price {
      color: #000;
  }

  .productBlockGrid .product-grid__price.abtest .product-grid__compare-price {
      color: #C92127;
      margin-left: 6px;
  }

  .productBlockGrid .collection-form {
